<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DevBot.Cli</RootNamespace>
    <AssemblyName>DevBot.Cli</AssemblyName>
    
    <!-- Soporte para instalarlo como Global Tool: 'devbot' -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>devbot</ToolCommandName>
    <PackageId>DevBot.Cli</PackageId>
    <Version>1.4.6</Version>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.80.1-alpha" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.80.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Prompts\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>tools/net8.0/any/Prompts/</PackagePath>
    </None>
  </ItemGroup>

</Project>
